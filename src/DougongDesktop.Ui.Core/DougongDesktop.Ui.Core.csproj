<Project Sdk="Microsoft.NET.Sdk">

  <!-- slot 框架：UI 的装配机制本身，不涉及具体界面。
       独立成库的理由：它要能被测试工程引用（守卫刻意不引用 App），
       同时保证"UI 机制"与"UI 实现"分离——换布局、加插件都不动这里。 -->
  <PropertyGroup>
    <Description>Dougong Desktop UI 装配机制：slot 注册表与优先级路由</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只依赖 Avalonia 的控件模板与集合抽象，不引 Arc：
         slot 机制不该知道用了哪套组件库。 -->
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <!-- 全局 using 指向 DougongDesktop.Ipc（见 Directory.Build.props），
         因此这里必须引用它——using 不能凭空引入一个程序集里没有的命名空间。
         目前 Ui.Core 的源码没用到任何契约类型，但 using 是编译期生效的，
         少了这条引用会 CS0246。 -->
    <ProjectReference Include="..\DougongDesktop.Ipc\DougongDesktop.Ipc.csproj" />
  </ItemGroup>

</Project>
