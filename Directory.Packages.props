<Project>

  <!-- 集中包版本管理。Avalonia 必须精确 12.1.4：TKCode.Arc 用
       <dependency version="[12.1.4]" /> 精确锁定，引任何其它版本都会
       报 NU1605（错误，不是警告），见 docs/arc-integration.md。 -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />

    <PackageVersion Include="TKCode.Arc" Version="1.0.0" />
    <PackageVersion Include="TKCode.Arc.Fonts" Version="1.0.0" />
    <!-- agent 组件不在主包：ToolCall/AgentStatus/AgentPlan/ContextWindow 在 Special，
         Sidebar/CommandPalette/ModelPicker 在 Blocks。见 docs/arc-integration.md -->
    <PackageVersion Include="TKCode.Arc.Special" Version="1.0.0" />
    <PackageVersion Include="TKCode.Arc.Blocks" Version="1.0.0" />
    <PackageVersion Include="TKCode.Arc.Terminal" Version="1.0.0" />
    <PackageVersion Include="TKCode.Arc.Workflow" Version="1.0.0" />
    <PackageVersion Include="TKCode.Arc.Icons.Lucide" Version="1.0.0" />
    <!-- Dock：IDE 式停靠布局（分裂标签树）。P8e E4 用它，不再自建。 -->
    <PackageVersion Include="TKCode.Arc.Dock" Version="1.0.0" />

    <!-- Spyglass：Avalonia 的 out-of-process 调试器（视觉树/样式/绑定/性能）。
         只给 Debug 构建用：生产包里不该带调试探针。
         它的 Avalonia 版本要求与我们一致（12.1.4 精确）。 -->
    <PackageVersion Include="TKCode.Spyglass.Agent" Version="0.2.3" />

    <!-- 无头 UI 检查：Avalonia 的无显示链接渲染。
         只给 tests/DougongDesktop.Ui.Headless.Checks 用；版本必须与 Avalonia 一致。 -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />

    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />

    <!-- Dougong SDK：来自 nuget.org。版本写死，与 SDK 仓库的发布节奏解耦——
         升级时只改这里一行，而不是跟着 SDK 的 main 分支漂。 -->
    <!-- Dougong.HostProtocol 曾经在这里。契约搬进 DougongDesktop.Ipc 之后
         已无工程引用它——本仓库的线上格式由 Contract.cs 自持。
         若将来又需要它（比如换回 SDK 的 ProtocolMapping），记得连版本一起加回。 -->
    <PackageVersion Include="Dougong.Agent" Version="0.1.21-alpha.1" />
    <PackageVersion Include="Dougong.Ai" Version="0.1.21-alpha.1" />
    <PackageVersion Include="Dougong.Hosting" Version="0.1.21-alpha.1" />
  </ItemGroup>

</Project>
