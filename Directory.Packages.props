<Project>

  <!-- 集中包版本管理。
       Avalonia 12.1.5：TKCode.Arc 1.1.x 的依赖是 `Avalonia [12.1.5, 13.0.0)`，
       低于 12.1.5 会 NU1605。12.1.4 时代 Arc 用的是精确锁定 `[12.1.4]`，
       那条约束在 1.1.0 已经放开成区间——版本必须成对升级，不能只升一边。
       Arc 1.1.1-preview.2 的约束与 1.1.0 相同（已核 nuspec），故 Avalonia 不用再动。 -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.2.0" />

    <PackageVersion Include="TKCode.Arc" Version="1.3.2-preview.4" />
    <PackageVersion Include="TKCode.Arc.Fonts" Version="1.3.2-preview.4" />
    <!-- agent 组件不在主包：ToolCall/AgentStatus/AgentPlan/ContextWindow 在 Special，
         Sidebar/CommandPalette/ModelPicker 在 Blocks。见 docs/arc-integration.md -->
    <PackageVersion Include="TKCode.Arc.Special" Version="1.3.2-preview.4" />
    <PackageVersion Include="TKCode.Arc.Blocks" Version="1.3.2-preview.4" />
    <PackageVersion Include="TKCode.Arc.Terminal" Version="1.3.2-preview.4" />
    <PackageVersion Include="TKCode.Arc.Icons.Lucide" Version="1.3.2-preview.4" />
    <!-- 1.3.0 起 Markdown 从主包拆成独立包。我们直接 new Markdown()，
         所以显式引用——不靠传递依赖：上游再拆一次就会编译失败。 -->
    <PackageVersion Include="TKCode.Arc.Markdown" Version="1.3.2-preview.4" />
    <!-- Dock：IDE 式停靠布局（分裂标签树）。P8e E4 用它，不再自建。 -->
    <PackageVersion Include="TKCode.Arc.Dock" Version="1.3.2-preview.4" />

    <!-- Spyglass：Avalonia 的 out-of-process 调试器（视觉树/样式/绑定/性能）。
         只给 Debug 构建用：生产包里不该带调试探针。
         它的 nuspec 写的是裸 `12.1.4`，NuGet 语义等于 `>= 12.1.4`，
         所以与 Avalonia 12.1.5 共存（已实测 restore 通过）。 -->
    <PackageVersion Include="TKCode.Spyglass.Agent" Version="0.2.3" />

    <!-- 无头 UI 检查：Avalonia 的无显示链接渲染。
         只给 tests/DougongDesktop.Ui.Headless.Checks 用；版本必须与 Avalonia 一致。 -->
    <PackageVersion Include="Avalonia.Headless" Version="12.2.0" />

    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />

    <!-- Dougong SDK：来自 nuget.org。版本写死，与 SDK 仓库的发布节奏解耦——
         升级时只改这里一行，而不是跟着 SDK 的 main 分支漂。 -->
    <!-- Dougong.HostProtocol 曾经在这里。契约搬进 DougongDesktop.Ipc 之后
         已无工程引用它——本仓库的线上格式由 Contract.cs 自持。
         若将来又需要它（比如换回 SDK 的 ProtocolMapping），记得连版本一起加回。 -->
    <PackageVersion Include="Dougong.Agent" Version="0.2.0-alpha.1" />
    <PackageVersion Include="Dougong.Ai" Version="0.2.0-alpha.1" />
    <PackageVersion Include="Dougong.Hosting" Version="0.2.0-alpha.1" />
  </ItemGroup>

</Project>
