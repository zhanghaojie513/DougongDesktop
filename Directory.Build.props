<Project>

  <!-- 公共属性。与 SDK 仓库的 Directory.Build.props 无关——本项目是独立仓库，
       同级目录，不继承 C:\work\myProject\dougong 的 CPM 设置。 -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Haojie Zhang</Authors>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本仓库自持的线上契约。Ipc 工程声明了全部消息类型，
         UI 层、框架层、宿主层都用它——一处声明，五处生效。

         **这里只有 using，没有 PackageReference**：契约是我们自己的工程，
         由各项目按需 ProjectReference（或经 Framework / Ipc 传递引入）。
         曾经这里还有一条 `Dougong.HostProtocol` 的全局 PackageReference，
         那让 Ipc 悄悄依赖了 SDK 的词汇表——守卫读 csproj 时看不见它。
         现在契约搬进本仓库，那条引用已删除；`Dougong.HostProtocol` 只在
         Framework 与 AgentHost 里显式引用（它们需要把 SDK 类型映射成我们的）。 -->
    <Using Include="DougongDesktop.Ipc" />
  </ItemGroup>

</Project>
